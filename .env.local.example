# ────────────────────────────────────────────────────────────────
# Health Care — Environment Variables
# Copy this file to `.env.local` and fill in your values.
# ────────────────────────────────────────────────────────────────

# === Supabase (Database + Auth) ===
# Create a free project at https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth (for "Continue with Google")
# Google Cloud Console → APIs & Services → Credentials → OAuth Client
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REDIRECT_URL=http://localhost:3000/auth/callback

# === Google Maps (Hospital Locator) ===
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# === Google Gemini (AI Health Assistant) ===
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# === FastAPI Backend (optional — the Next.js API routes proxy AI by default) ===
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# === App config ===
NEXT_PUBLIC_APP_NAME=Health Care
NEXT_PUBLIC_APP_URL=http://localhost:3000
